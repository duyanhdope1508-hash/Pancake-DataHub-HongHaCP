# PostgreSQL local development
POSTGRES_DB=pancake_data
POSTGRES_USER=pancake_app
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+psycopg://pancake_app:change_this_password@127.0.0.1:15432/pancake_data

# Pancake POS Open API
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=replace_with_your_key
# Optional comma-separated allowlist. Leave empty to use every shop visible to the key.
PANCAKE_SHOP_IDS=
# Optional multi-key config. When this file exists it replaces PANCAKE_API_KEY.
PANCAKE_CONNECTORS_FILE=secrets/pancake_connectors.json
# Separate tokens for the Pancake Pages conversations API.
PANCAKE_PAGES_CONNECTORS_FILE=secrets/pancake_pages_connectors.json
PANCAKE_PAGE_SIZE=100
PANCAKE_START_PAGE=1
PANCAKE_MAX_PAGES=1
PANCAKE_INCREMENTAL_MAX_PAGES=100
PANCAKE_INCREMENTAL_UNCHANGED_PAGES=2
PANCAKE_SYNC_CONCURRENCY=4
PANCAKE_RESUME_BACKFILL=false
PANCAKE_SYNC_INTERVAL_SECONDS=300
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
TRUSTED_HOSTS=*
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_STAFF_MAX_SESSIONS=2
STAFF_ORDER_ROWS_PER_HOUR=2000
STAFF_ORDER_DETAILS_PER_HOUR=120
ADMIN_ORDER_ROWS_PER_HOUR=20000
ADMIN_ORDER_DETAILS_PER_HOUR=1200
STAFF_EXPORTS_PER_HOUR=5
STAFF_EXPORT_ROWS_PER_DAY=2000
AUDIT_DETAIL_DEDUP_SECONDS=600
AUDIT_DETAIL_RETENTION_DAYS=90
AUDIT_GENERAL_RETENTION_DAYS=365
AUDIT_CLEANUP_INTERVAL_SECONDS=86400

