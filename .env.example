# PostgreSQL local development
POSTGRES_DB=pancake_data
POSTGRES_USER=pancake_app
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+psycopg://pancake_app:change_this_password@db:5432/pancake_data

# Pancake POS Open API
PANCAKE_API_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_API_KEY=replace_with_your_key
# Optional comma-separated allowlist. Leave empty to use every shop visible to the key.
PANCAKE_SHOP_IDS=
PANCAKE_PAGE_SIZE=100

